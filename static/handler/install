#!/usr/bin/env bash
# Copyright (c) 2026 The Agency HQ
# SPDX-License-Identifier: MIT
#
# Installs The Agency Handler on macOS or Linux:
#
#   curl -fsSL https://theagencyhq.org/handler/install | bash
#
# Finds the latest release through the GitHub API, downloads the artifact for
# this platform, verifies it against the SHA-256 digest the API reports for the asset, then hands off to the
# platform installer — the signed .pkg on macOS, the archive's install.sh on Linux. Everything installs per-user;
# no sudo. Re-running upgrades in place.
#
# The whole script runs from main() on the last line, so a partially downloaded script executes nothing.
set -euo pipefail

REPO="the-agency-hq/handler"

fail() {
  echo "$1" >&2
  exit 1
}

sha256() {
  if command -v sha256sum > /dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

main() {
  local os
  case "$(uname -s)" in
    Darwin) os="macos" ;;
    Linux)  os="linux" ;;
    *) fail "Unsupported operating system [$(uname -s)]. The Handler runs on macOS and Linux." ;;
  esac

  local arch
  case "$(uname -m)" in
    arm64 | aarch64) arch="arm64" ;;
    x86_64 | amd64)  arch="amd64" ;;
    *) fail "Unsupported architecture [$(uname -m)]. The Handler ships for arm64 and amd64." ;;
  esac

  local api="https://api.github.com/repos/${REPO}/releases/latest"

  echo "Fetching release information..."
  local release
  release=$(curl -fsSL "$api") || fail "Unable to query [$api]"

  local version
  version=$(printf '%s\n' "$release" | grep '"tag_name"' | head -1 | sed 's/.*"tag_name": *"\([^"]*\)".*/\1/')
  [[ -n "$version" ]] || fail "Unable to determine the release version from [$api]"

  local asset
  if [[ "$os" == "macos" ]]; then
    asset="the-agency-hq-handler-${version}-macos-${arch}.pkg"
  else
    asset="the-agency-hq-handler-${version}-linux-${arch}.tar.gz"
  fi

  # Each asset object in the API response lists its "name" before its "digest", and no other "name" key appears
  # between them, so the digest that follows the matching name line belongs to this asset
  local digest
  digest=$(printf '%s\n' "$release" | awk -v asset="$asset" '
      /"name":/ { found = index($0, "\"" asset "\"") > 0 }
      found && /"digest":/ { if (match($0, /sha256:[0-9a-f]{64}/)) print substr($0, RSTART + 7, RLENGTH - 7); exit }')

  # Deliberately not local: the EXIT trap runs after main returns, where a local would be unbound under set -u
  tmp=$(mktemp -d)
  trap 'rm -rf "${tmp}"' EXIT

  echo "Downloading the Handler ${version} for ${os}-${arch}..."
  curl -fL --progress-bar -o "${tmp}/${asset}" "https://github.com/${REPO}/releases/download/${version}/${asset}" \
      || fail "Unable to download [${asset}] from the [${version}] release"

  if [[ -z "$digest" ]]; then
    echo "WARNING: The GitHub API reported no digest for [${asset}], so the download cannot be verified." >&2
  else
    local actual
    actual=$(sha256 "${tmp}/${asset}")
    [[ "$actual" == "$digest" ]] \
        || fail "Checksum mismatch for [${asset}]: expected [${digest}] but computed [${actual}]. Not installing."
    echo "Verified the SHA-256 checksum."
  fi

  if [[ "$os" == "macos" ]]; then
    # The pkg installs into the home directory, which needs no privileges
    installer -pkg "${tmp}/${asset}" -target CurrentUserHomeDirectory

    case ":$PATH:" in
      *":$HOME/.local/bin:"*) ;;
      *) echo "Add [$HOME/.local/bin] to your PATH to run [handler] directly." ;;
    esac
    echo "The Agency Handler is installed."
    echo ""
    echo "Log in to The Agency HQ with:"
    echo "  handler login"
  else
    tar xzf "${tmp}/${asset}" -C "${tmp}"
    # install.sh places the payload, the systemd user unit, and the tray autostart, then starts the daemon
    "${tmp}/the-agency-hq-handler-${version}/install.sh"
  fi
}

main
